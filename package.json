{
  "name": "twinstage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite web",
    "build": "vite build web",
    "preview": "vite preview web",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "concurrently -n web,bridge -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "server:dry": "ARM_DRY=1 BASE_DRY=1 node --env-file-if-exists=.env server/index.js",
    "jog": "${ARM_PYTHON:-python3} drivers/jog.py",
    "lint": "eslint .",
    "test": "vitest run --root web"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "express": "^4.19.2",
    "lucide": "^0.427.0",
    "three": "0.128.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "description": "Live 3D digital twins for LeRobot arms and bases: drive them by hand tracking, a leader arm or the keyboard.",
  "license": "Apache-2.0",
  "author": "Charan Sai Soma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charansoma3001/twinstage.git"
  },
  "engines": {
    "node": ">=22.9"
  }
}
