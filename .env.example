# Copy to .env and uncomment what your rig needs. `npm run server` reads .env if it exists.
# With nothing set the bridge accepts commands, logs them and moves nothing.

# --- Bridge -----------------------------------------------------------------
# PORT=8787

# --- SO-101 arms (LeRobot) --------------------------------------------------
# A Python interpreter with LeRobot installed (default: python3 on PATH).
# ARM_PYTHON=/path/to/lerobot/.venv/bin/python
# Follower: serial device and LeRobot calibration id.
# ARM_PORT=/dev/tty.usbmodemXXXXXXXX
# ARM_ID=follower
# Leader: serial device, calibration id, and where its teleoperator calibration lives.
# LEADER_PORT=/dev/tty.usbmodemYYYYYYYY
# LEADER_ID=leader
# LEADER_CAL_DIR=/path/to/home/.cache/huggingface/lerobot/calibration/teleoperators/so_leader
# 1 = run both arm drivers without touching hardware.
# ARM_DRY=1
# Dry run only: the pose a dry driver reports, as JSON in LeRobot degrees.
# FOLLOWER_DRY_PRESENT={"shoulder_pan": 10}
# LEADER_DRY_PRESENT={"shoulder_pan": -10}

# --- LeKiwi base (optional) -------------------------------------------------
# ssh destination of the base's Raspberry Pi; the driver is sent over ssh.
# BASE_HOST=pi@lekiwi.local
# BASE_PYTHON=~/lerobot/.venv/bin/python
# BASE_SERIAL=/dev/ttyACM0
# 1 = simulate the base locally, touching no hardware.
# BASE_DRY=1
# Interpreter for the local dry run (default: python3).
# BASE_LOCAL_PYTHON=python3

# --- Web build (read by Vite at build time) ---------------------------------
# VITE_BRIDGE_URL=ws://localhost:8787
# Optional presenter card on the stage for live demos.
# VITE_PRESENTER_NAME=Your Name
# VITE_PRESENTER_EVENT=Robotics Open Day
# VITE_PRESENTER_QR=/presenter-qr.png
# VITE_PRESENTER_CAPTION=Scan to connect
